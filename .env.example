# ============================================================================
# Quiltt Next.js Template — Environment Variables
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env.local`  (already git-ignored)
# 2. Fill in your credentials from the Quiltt Dashboard:
#    https://dashboard.quiltt.dev
#
# Full guide: https://quiltt.dev
# ============================================================================

# ---- Server-only (never expose to the browser, never commit) ----------------

# Quiltt API key secret used to issue Session tokens and to introspect the
# GraphQL schema during codegen. Looks like: qltt_...
QUILTT_API_KEY_SECRET=""

# The Quiltt Profile ID (p_...) that the template's demo "Sign in" uses to mint
# a Session token. In a real application you would resolve this from your own
# identity provider instead (see the auth seam in src/lib/quiltt.ts).
#
# Optional — if left empty, the sign-in page will ask you for a Profile ID.
QUILTT_USER_ID=""

# ---- Public (NEXT_PUBLIC_* is inlined into the browser bundle) -------------

# The Connector ID you created under "Connectors" in the Quiltt Dashboard.
# Used by <QuilttButton> / <QuilttContainer> to launch the Connector.
NEXT_PUBLIC_QUILTT_CONNECTOR_ID=""
